#!/usr/bin/env bash
# Route editor-aware window actions through Herdr or tmux.
set -euo pipefail
# Every key press starts this script anew, and starting a process can cost
# 40-160 ms (on Android, for example). Keep state, parsing, and foreground
# detection in Bash builtins, and ask tmux for everything in one query.
umask 077

usage() { echo 'usage: edger [cross] [resize] left|down|up|right [forward-key] | [cross] horizontal|vertical|close [forward-key] | [cross] clear' >&2; exit 2; }
mode=normal
if [[ ${1-} == cross ]]; then mode=cross; shift; fi
operation=navigate
if [[ ${1-} == resize ]]; then operation=resize; shift; fi
name=${1-}
case $name in
  left) letter=h; step=-1; tmux_dir=L ;;
  down) letter=j; step=1; tmux_dir=D ;;
  up) letter=k; step=-1; tmux_dir=U ;;
  right) letter=l; step=1; tmux_dir=R ;;
  horizontal) letter=u ;; vertical) letter=i ;; close) letter=w ;;
  clear) operation=clear; letter= ;;
  *) usage ;;
esac
if [[ $operation == resize && $name != left && $name != right && $name != up && $name != down ]]; then usage; fi
[[ $# -le 2 ]] || usage
shift_key=
[[ $operation == resize ]] && shift_key=shift+
key=${2:-${EDGER_KEY_MODIFIER:-alt}+$shift_key$letter}
if [[ $operation == navigate && $name != left && $name != right && $name != up && $name != down ]]; then operation=$name; fi
dir=$name
backend=${EDGER_BACKEND:-}
if [[ -z $backend ]]; then
  if [[ -n ${TMUX-} ]]; then backend=tmux
  elif [[ -n ${HERDR_PANE_ID-}${HERDR_ACTIVE_PANE_ID-} ]]; then backend=herdr
  else exit 0
  fi
fi

# Parse all available process identities. Herdr's display name alone can be a
# wrapper name, while argv[0] still identifies the actual editor binary.
editor_re='^(emacs|emacsclient|nvim|vim|vi|view|gvim|nvimdiff|vimdiff)$'
editor_name() {
  local name=${1##*/}
  [[ ${name,,} =~ $editor_re ]]
}

herdr=${HERDR_BIN_PATH:-herdr}
herdr_pane=${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}
tmux_cmd=${TMUX_BIN_PATH:-tmux}
tmux_pane=${TMUX_PANE:-}

# The shell command exits between presses, so keep one short-lived state per pane.
boundary_timeout=${EDGER_BOUNDARY_TIMEOUT_MS:-700}
creation_idle=${EDGER_CREATION_IDLE_MS:-400}
[[ $boundary_timeout =~ ^[1-9][0-9]*$ && $creation_idle =~ ^[1-9][0-9]*$ ]] || {
  echo 'edger: boundary timeout and creation idle must be positive milliseconds' >&2; exit 2;
}
case $backend in
  herdr)
    command -v "$herdr" >/dev/null || { echo "edger: Herdr executable not found: $herdr" >&2; exit 1; }
    [[ -n $herdr_pane ]] || { echo 'edger: no Herdr pane id' >&2; exit 1; } ;;
  tmux)
    command -v "$tmux_cmd" >/dev/null || { echo "edger: tmux executable not found: $tmux_cmd" >&2; exit 1; } ;;
  *) echo "edger: unknown backend: $backend" >&2; exit 2 ;;
esac

tmux_run() { "$tmux_cmd" "$@"; }
if [[ $backend == tmux ]]; then
  [[ -n $tmux_pane ]] || tmux_pane=$(tmux_run display-message -p '#{pane_id}')
  # One query for every value a press may need. The unit separator keeps
  # empty fields, such as a detached session's client, in place.
  sep=$'\x1f'
  info=$(tmux_run display-message -p -t "$tmux_pane" \
    "#{pane_pid}$sep#{pane_current_command}$sep#{pane_tty}$sep#{window_zoomed_flag}$sep#{pane_at_left}$sep#{pane_at_right}$sep#{pane_at_top}$sep#{pane_at_bottom}$sep#{window_id}$sep#{session_id}$sep#{session_windows}$sep#{window_panes}$sep#{server_sessions}$sep#{client_tty}$sep#{pane_current_path}")
  IFS=$sep read -r pane_pid pane_command pane_tty zoomed at_left at_right at_top at_bottom \
    window_id session_id session_windows window_panes server_sessions client_tty pane_path <<< "$info"
  # Key bindings pass the pressing client; editor integrations use the pane's.
  EDGER_TMUX_CLIENT_TTY=${EDGER_TMUX_CLIENT_TTY:-$client_tty}
fi

state_dir=${EDGER_STATE_DIR:-${XDG_RUNTIME_DIR:-$HOME/.cache}/edger}
state_path() {
  local id=$1
  printf -v "$2" '%s/%s' "$state_dir" "${id//[^[:alnum:]_.-]/_}"
}
if [[ $backend == tmux ]]; then
  # TMUX ends in server PID and session index; only the socket survives a session switch.
  state_context=${TMUX:-}
  state_context=${state_context%,*,*}
else state_context=${HERDR_SOCKET_PATH:-}; fi
state_path "$backend:$state_context:${tmux_pane:-$herdr_pane}" state_file
# Emptying a file clears it without starting rm.
state_clear() { [[ ! -s $state_file ]] || : > "$state_file"; }
state_mkdir() { [[ -d $state_dir ]] || mkdir -p -- "$state_dir"; }
# Outer navigation changes the active pane. Keep its recent-key history per client
# (or Herdr socket), while confirmation remains isolated to the current pane.
scope=$state_context
[[ $backend != tmux ]] || scope+=:${EDGER_TMUX_CLIENT_TTY:-$tmux_pane}
state_path "travel:$backend:$scope" travel_file
travel_clear() { [[ ! -s $travel_file ]] || : > "$travel_file"; }
travel_save() {
  state_mkdir
  printf '%s %s\n' "$dir" "$now" > "$travel_file"
}
travel_recent() {
  local previous_dir='' previous_at=''
  [[ -s $travel_file ]] || return 1
  read -r previous_dir previous_at < "$travel_file" || :
  if [[ $previous_dir != "$dir" ]]; then travel_clear; return 1; fi
  [[ $previous_at =~ ^[0-9]+$ ]] &&
    (( now >= previous_at && now - previous_at < creation_idle * 1000 ))
}
state_save() {
  state_mkdir
  printf '%s %s %s %s\n' "$1" "$dir" "$now" "$now" > "$state_file"
}
state_load() {
  phase='' armed_dir='' armed_at='' last_press=''
  if [[ -s $state_file ]]; then read -r phase armed_dir armed_at last_press < "$state_file" || :; fi
  if [[ $phase != create || $armed_dir != "$dir" ||
        ! $armed_at =~ ^[0-9]+$ || ! $last_press =~ ^[0-9]+$ ]] ||
     (( now < armed_at || now < last_press || now - armed_at > boundary_timeout * 1000 )); then
    state_clear
    phase=
  fi
}
# Key-up events are not available in traditional terminals. Ignore a stream of
# auto-repeat events after the first confirmation, rather than creating on hold.
state_repeating() {
  if (( now - last_press < 120000 )); then
    printf '%s %s %s %s\n' "$phase" "$dir" "$armed_at" "$now" > "$state_file"
    return 0
  fi
  return 1
}
if [[ $operation != navigate ]]; then state_clear; travel_clear; [[ $operation != clear ]] || exit 0; fi
herdr_process_is_editor() {
  "$herdr" pane process-info --pane "$herdr_pane" 2>/dev/null | jq -e '
    any(.result.process_info.foreground_processes[]?;
      [.name?, .argv0?, .argv[0]?] |
      any(.[] | select(. != null); (split("/")[-1] | ascii_downcase) |
        test("^(emacs|emacsclient|nvim|vim|vi|view|gvim|nvimdiff|vimdiff)$")))
  ' >/dev/null 2>&1
}
herdr_next() {
  local kind=$1 id=$2 field=$3 list=$4
  local args=()
  [[ -z ${5:-} ]] || args=(--workspace "$5")
  "$herdr" "$kind" list "${args[@]}" |
    jq -r --arg id "$id" --arg field "$field" --arg list "$list" --argjson step "$step" '
      [.result[$list][]?] | sort_by(.number) |
      (map(.[$field]) | index($id)) as $i |
      if $i != null and ($i + $step >= 0) and ($i + $step < length)
      then .[$i + $step][$field] else empty end'
}
herdr_cross() {
  local response edges
  edges=$("$herdr" pane edges --pane "$herdr_pane") || return 1
  if jq -e --arg dir "$dir" '.result.edges | .layout.zoomed and (.[$dir] == false)' <<< "$edges" >/dev/null; then
    "$herdr" pane zoom --pane "$herdr_pane" --off >/dev/null
  fi
  response=$("$herdr" pane focus --direction "$dir" --pane "$herdr_pane") || return 1
  if [[ $(jq -r '.result.focus.changed' <<< "$response") != false ]]; then
    state_clear
  else
    boundary_edge
  fi
}
herdr_neighbor() {
  local current workspace tab
  current=$("$herdr" pane current --pane "$herdr_pane" | jq -r '.result.pane | "\(.workspace_id) \(.tab_id)"')
  read -r workspace tab <<< "$current"
  if [[ $dir == left || $dir == right ]]; then
    target=$(herdr_next tab "$tab" tab_id tabs "$workspace")
  else
    target=$(herdr_next workspace "$workspace" workspace_id workspaces)
  fi
}
herdr_outer_focus() {
  if [[ $dir == left || $dir == right ]]; then "$herdr" tab focus "$1" >/dev/null
  else "$herdr" workspace focus "$1" >/dev/null; fi
}
herdr_outer_create() {
  local workspace
  if [[ $dir == right ]]; then
    workspace=$("$herdr" pane current --pane "$herdr_pane" | jq -r '.result.pane.workspace_id')
    "$herdr" tab create --workspace "$workspace" --focus >/dev/null
  else
    "$herdr" workspace create --focus >/dev/null
  fi
}
herdr_action() {
  local workspace count
  case $operation in
    resize) "$herdr" pane resize --direction "$name" --pane "$herdr_pane" >/dev/null 2>&1 || : ;;
    horizontal) "$herdr" pane split --pane "$herdr_pane" --direction down --focus >/dev/null ;;
    vertical) "$herdr" pane split --pane "$herdr_pane" --direction right --focus >/dev/null ;;
    close)
      workspace=$("$herdr" pane current --pane "$herdr_pane" | jq -r '.result.pane.workspace_id')
      count=$("$herdr" workspace list | jq '.result.workspaces | length')
      if [[ $count == 1 ]] && [[ $("$herdr" workspace get "$workspace" | jq -r '.result.workspace.pane_count') == 1 ]]; then return; fi
      "$herdr" pane close "$herdr_pane" >/dev/null ;;
  esac
}

# Process stat lines are "PID (COMM) STATE PPID PGRP SESSION TTY TPGID ...";
# COMM may hold spaces or parentheses, so split after its last ')'.
proc_stat() {
  local stat rest
  read -r stat 2>/dev/null < "/proc/$1/stat" || return 1
  proc_comm=${stat#*\(}
  proc_comm=${proc_comm%\)*}
  # Expansions, not a here-string: this runs for every process in a scan.
  rest=${stat##*) }; rest=${rest#* }; rest=${rest#* }
  proc_pgrp=${rest%% *}
  rest=${rest#* }; rest=${rest#* }; rest=${rest#* }
  proc_tpgid=${rest%% *}
}
tmux_editor_ps() {
  local state name command
  # A foreground process owns '+' in ps STAT. Check executable argv[0] too,
  # since emacsclient can be renamed by its wrapper.
  while read -r state name command; do
    if [[ $state == *+* ]] && { editor_name "$name" || editor_name "${command%% *}"; }; then return 0; fi
  done < <(ps -t "$pane_tty" -o stat= -o comm= -o args= 2>/dev/null)
  return 1
}
tmux_editor() {
  local tpgid children f pid argv0
  # tmux names the foreground process group's leader, which covers editors
  # started from a shell prompt.
  editor_name "$pane_command" && return 0
  # Without Linux /proc (macOS, for example), ask ps.
  proc_stat "$pane_pid" || { tmux_editor_ps; return; }
  tpgid=$proc_tpgid
  # A pane shell at its prompt leads the foreground group. With no children,
  # nothing else can be in it.
  if [[ $tpgid == "$proc_pgrp" && -r /proc/$pane_pid/task/$pane_pid/children ]]; then
    read -r children < "/proc/$pane_pid/task/$pane_pid/children" || :
    [[ -n $children ]] || return 1
  fi
  # Look for an editor elsewhere in the foreground group, such as one started
  # by git commit. Android lacks the children file and lists few processes.
  for f in /proc/[0-9]*; do
    pid=${f#/proc/}
    proc_stat "$pid" || continue
    [[ $proc_pgrp == "$tpgid" ]] || continue
    editor_name "$proc_comm" && return 0
    argv0=
    read -r -d '' argv0 2>/dev/null < "/proc/$pid/cmdline" || :
    editor_name "$argv0" && return 0
  done
  return 1
}

# Print the ID STEP places from CURRENT among IDS, if any.
next_id() {
  local current=$1 i
  shift
  local ids=("$@")
  for i in "${!ids[@]}"; do
    [[ ${ids[i]} == "$current" ]] || continue
    i=$((i + step))
    if (( i >= 0 && i < ${#ids[@]} )); then target=${ids[i]}; fi
    return 0
  done
}
# Sessions in creation order, ties broken by ID.
tmux_sessions() {
  local list created id key i
  local -a keys=()
  sessions=()
  list=$(tmux_run list-sessions -F '#{session_created} #{session_id}')
  while read -r created id; do
    key=$(( created * 1000000 + ${id#\$} ))
    i=${#keys[@]}
    while (( i > 0 && keys[i - 1] > key )); do
      keys[i]=${keys[i - 1]}; sessions[i]=${sessions[i - 1]}; i=$((i - 1))
    done
    keys[i]=$key; sessions[i]=$id
  done <<< "$list"
}
tmux_outer_enabled() {
  [[ $dir == left || $dir == right || -n $EDGER_TMUX_CLIENT_TTY ]]
}
tmux_outer_neighbor() {
  local windows
  local -a ids
  if [[ $dir == left || $dir == right ]]; then
    windows=$(tmux_run list-windows -t "$window_id" -F '#{window_id}')
    mapfile -t ids <<< "$windows"
    next_id "$window_id" "${ids[@]}"
  else
    tmux_sessions
    next_id "$session_id" "${sessions[@]}"
  fi
}
tmux_outer_focus() {
  if [[ $dir == left || $dir == right ]]; then tmux_run select-window -t "$1"
  else tmux_run switch-client -c "$EDGER_TMUX_CLIENT_TTY" -t "$1"; fi
}
tmux_outer_create() {
  local session
  if [[ $dir == right ]]; then
    tmux_run new-window -a -t "$window_id" -c '#{pane_current_path}'
  else
    session=$(tmux_run new-session -d -P -F '#{session_id}' -c "$pane_path")
    tmux_run switch-client -c "$EDGER_TMUX_CLIENT_TTY" -t "$session"
  fi
}
outer_enabled() {
  [[ $backend == herdr ]] || tmux_outer_enabled
}
outer_neighbor() {
  target=
  if [[ $backend == herdr ]]; then herdr_neighbor; else tmux_outer_neighbor; fi
}
outer_focus() {
  if [[ $backend == herdr ]]; then herdr_outer_focus "$1"; else tmux_outer_focus "$1"; fi
}
outer_create() {
  if [[ $backend == herdr ]]; then herdr_outer_create; else tmux_outer_create; fi
}
boundary_edge() {
  if ! outer_enabled; then state_clear; return; fi
  # EPOCHREALTIME uses the locale's decimal separator.
  now=${EDGER_TEST_NOW_US:-${EPOCHREALTIME//[!0-9]/}}
  [[ $now =~ ^[0-9]+$ ]] || { echo 'edger: invalid boundary clock' >&2; return 2; }
  outer_neighbor
  if [[ -n $target ]]; then
    state_clear
    outer_focus "$target"
    travel_save
  elif [[ $step == 1 ]]; then
    if travel_recent; then state_clear; travel_save; return; fi
    state_load
    if [[ -z $phase ]]; then state_save create; return; fi
    if state_repeating; then return; fi
    state_clear
    outer_create
    travel_save
  else
    state_clear
    travel_clear
  fi
}

tmux_cross() {
  local at_edge
  case $dir in
    left) at_edge=$at_left ;; right) at_edge=$at_right ;;
    up) at_edge=$at_top ;; down) at_edge=$at_bottom ;;
  esac
  # A zoomed pane reports every edge, so ask again after unzooming.
  if [[ $zoomed == 1 ]]; then
    tmux_run resize-pane -Z -t "$tmux_pane"
    case $dir in
      left) at_edge=$(tmux_run display-message -p -t "$tmux_pane" '#{pane_at_left}') ;;
      right) at_edge=$(tmux_run display-message -p -t "$tmux_pane" '#{pane_at_right}') ;;
      up) at_edge=$(tmux_run display-message -p -t "$tmux_pane" '#{pane_at_top}') ;;
      down) at_edge=$(tmux_run display-message -p -t "$tmux_pane" '#{pane_at_bottom}') ;;
    esac
  fi
  if [[ $at_edge == 0 ]]; then
    tmux_run select-pane -t "$tmux_pane" "-$tmux_dir"
    state_clear
  else
    [[ $zoomed != 1 ]] || tmux_run resize-pane -Z -t "$tmux_pane"
    boundary_edge
  fi
}

tmux_action() {
  case $operation in
    resize)
      local amount=3
      [[ $name == left || $name == right ]] && amount=5
      tmux_run resize-pane -t "$tmux_pane" "-$tmux_dir" "$amount" 2>/dev/null || : ;;
    horizontal) tmux_run split-window -t "$tmux_pane" -c '#{pane_current_path}' ;;
    vertical) tmux_run split-window -h -t "$tmux_pane" -c '#{pane_current_path}' ;;
    close)
      if [[ $server_sessions == 1 && $session_windows == 1 && $window_panes == 1 ]]; then return; fi
      tmux_run kill-pane -t "$tmux_pane" ;;
  esac
}

case $backend in
  herdr)
    if [[ $mode == normal ]] && herdr_process_is_editor; then
      "$herdr" pane send-keys "$herdr_pane" "$key" >/dev/null
    elif [[ $operation == navigate ]]; then
      herdr_cross
    else
      herdr_action
    fi ;;
  tmux)
    if [[ $mode == normal ]] && tmux_editor; then
      tmux_run send-keys -t "$tmux_pane" "$key"
    elif [[ $operation == navigate ]]; then
      tmux_cross
    else
      tmux_action
    fi ;;
esac
